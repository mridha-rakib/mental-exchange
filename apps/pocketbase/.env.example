PB_ENCRYPTION_KEY=replace-with-a-32-character-local-key
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=change-me

# PocketBase sends auth verification/password-reset emails.
# In docker-compose these can also come from apps/api/.env.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=info@example.com
SMTP_PASS=change-me
SMTP_TLS=true
SMTP_FROM=info@example.com
SMTP_FROM_NAME=Zahniboerse
FRONTEND_URL=https://zahniboerse.com
